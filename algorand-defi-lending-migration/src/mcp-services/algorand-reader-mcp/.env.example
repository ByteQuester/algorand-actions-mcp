# =============================================================================
# ALGORAND READER MCP SERVICE - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables needed for the Algorand Reader MCP service.
# Copy this file to .env and customize values for your environment.

# -----------------------------------------------------------------------------
# CORE SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=8080

# Service identification
SERVICE_NAME=algorand-reader-mcp
SERVICE_VERSION=1.5.0

# -----------------------------------------------------------------------------
# ALGORAND NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
# Network selection: mainnet, testnet, betanet, localnet
ALGORAND_NETWORK=mainnet

# Algod API Configuration
ALGORAND_ALGOD=https://mainnet-api.algonode.cloud
ALGORAND_ALGOD_API=https://mainnet-api.algonode.cloud/v2
ALGORAND_ALGOD_PORT=
ALGORAND_TOKEN=

# Indexer API Configuration
ALGORAND_INDEXER=https://mainnet-idx.algonode.cloud
ALGORAND_INDEXER_API=https://mainnet-idx.algonode.cloud/v2
ALGORAND_INDEXER_PORT=

# -----------------------------------------------------------------------------
# MCP PROTOCOL CONFIGURATION
# -----------------------------------------------------------------------------
# Enable read-only mode (disables transaction capabilities)
READ_ONLY=true

# Pagination settings
ITEMS_PER_PAGE=10

# -----------------------------------------------------------------------------
# EXTERNAL API INTEGRATIONS
# -----------------------------------------------------------------------------
# NFD (Non-Fungible Domains) API
NFD_API_URL=https://api.nf.domains

# Pera Wallet Integration
PERA_WALLET_API_URL=https://mainnet.api.perawallet.app/v1/public
PERA_EXPLORER_URL=https://explorer.perawallet.app

# -----------------------------------------------------------------------------
# OAUTH & AUTHENTICATION (Optional - for full OAuth mode)
# -----------------------------------------------------------------------------
# HashiCorp Vault Worker Integration
HCV_WORKER_URL=
HCV_TOKEN=

# OAuth Provider Secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Vault Configuration
VAULT_OIDC_ACCESSOR=
COOKIE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# CLOUDFLARE WORKER BINDINGS (Production Deployment)
# -----------------------------------------------------------------------------
# These are used in Cloudflare Worker deployment
# KV Namespace IDs
OAUTH_KV_ID=
VAULT_ENTITIES_ID=
PUBLIC_KEY_CACHE_ID=
CODE_VERIFIER_KV_ID=
ARC26_KV_ID=

# R2 Bucket Configuration
PLAUSIBLE_AI_BUCKET=

# Durable Object Configuration
DURABLE_OBJECT_CLASS=AlgorandRemoteMCP

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------
# Health check configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# CORS settings
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Rate limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100