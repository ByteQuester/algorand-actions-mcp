{
  "id": "algorand-writer-mcp",
  "name": "Algorand Blockchain Writer",
  "description": "WRITE operations to Algorand blockchain - build, simulate, and submit transactions",
  "version": "0.1.1",
  "type": "writer",
  "capabilities": {
    "read_only": false,
    "write_operations": true,
    "simulation": true,
    "mainnet_protection": true
  },
  "tools": [
    {
      "name": "build_payment_tx",
      "description": "Build an unsigned payment transaction",
      "parameters": {
        "fromAddress": "string (required) - Sender address",
        "toAddress": "string (required) - Recipient address",
        "microAlgos": "number (required) - Amount in micro-Algos",
        "note": "string (optional) - Transaction note"
      },
      "returns": {
        "unsignedTxn": "string - Base64 encoded unsigned transaction",
        "txnId": "string - Transaction ID"
      }
    },
    {
      "name": "simulate_raw_tx",
      "description": "Simulate an unsigned raw transaction to estimate costs and effects",
      "parameters": {
        "unsignedTxnBase64": "string (required) - Base64 encoded unsigned transaction"
      },
      "returns": {
        "simulationResult": "object - Detailed simulation results",
        "cost": "number - Estimated transaction cost",
        "success": "boolean - Whether simulation succeeded"
      }
    },
    {
      "name": "submit_signed_tx",
      "description": "Broadcast a signed transaction to the network",
      "parameters": {
        "signedTxnBase64": "string (required) - Base64 encoded signed transaction"
      },
      "returns": {
        "txnId": "string - Transaction ID",
        "success": "boolean - Whether submission succeeded"
      }
    },
    {
      "name": "get_health",
      "description": "Check the health status of the service",
      "parameters": {},
      "returns": {
        "status": "string - Service status",
        "network": "string - Connected network"
      }
    }
  ],
  "endpoints": [
    "POST /transactions/build - Build unsigned transaction",
    "POST /transactions/simulate - Simulate transaction effects",
    "POST /transactions/submit - Submit signed transaction",
    "GET /health - Service health check"
  ],
  "security": {
    "mainnet_gate": {
      "enabled": true,
      "description": "Prevents accidental mainnet operations without explicit confirmation"
    },
    "read_only_mode": {
      "enabled": false,
      "description": "Can be enabled to disable all write operations"
    }
  },
  "network": {
    "default": "testnet",
    "supported": ["testnet", "mainnet"],
    "mainnet_warning": "Mainnet operations require explicit confirmation"
  },
  "ports": {
    "development": 3001,
    "production": 3001
  },
  "transaction_types": [
    "payment",
    "asset_transfer",
    "asset_config",
    "application_call"
  ]
}