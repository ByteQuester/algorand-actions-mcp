{
	"name": "@algorand-showcase/market-data-mcp",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Market data MCP service for price feeds and oracle data",
	"scripts": {
		"build": "tsc",
		"deploy": "wrangler deploy --minify",
		"dev": "wrangler dev --port 8789",
		"format": "biome format --write",
		"lint:fix": "biome lint --fix",
		"start": "wrangler dev --port 8789",
		"cf-typegen": "wrangler types",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@algorand-showcase/config": "workspace:*",
		"@algorand-showcase/mcp-core": "workspace:*",
		"@algorand-showcase/types": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.12.1",
		"hono": "^4.8.0",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^20.17.24",
		"typescript": "^5.8.3",
		"wrangler": "^4.25.0"
	}
}