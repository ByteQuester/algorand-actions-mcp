   "source": [
    "## 9. Stress Testing Analysis\n",
    "\n",
    "Let's analyze the stress test results from our assessments."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract stress test results\n",
    "stress_results = []\n",
    "\n",
    "for result in analysis_results:\n",
    "    assessment = result['assessment']\n",
    "    stress_tests = assessment.stress_test_results\n",
    "    \n",
    "    for scenario, stress_score in stress_tests.items():\n",
    "        stress_results.append({\n",
