   "source": [
    "# Duration Risk Modeling Engine Demo\n",
    "\n",
    "This notebook demonstrates the capabilities of the Duration Risk Modeling Engine, which provides comprehensive term structure analysis, prepayment risk modeling, and duration-based risk assessment for cryptocurrency-backed loans.\n",
    "\n",
    "## Key Features\n",
    "- Term structure analysis for different loan periods\n",
    "- Prepayment risk modeling for crypto-backed loans\n",
    "- Interest rate sensitivity analysis\n",
    "- Duration matching for asset-liability management\n",
    "- Early termination probability estimation\n",
    "- Yield curve construction and analysis\n",
    "- Stress testing scenarios"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import required libraries\n",
    "import asyncio\n",
    "import json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from datetime import datetime, timedelta\n",
    "from decimal import Decimal\n",
    "from scipy import stats\n",
    "\n",
    "# Import duration risk modeling components\n",
    "from duration_risk_modeling.core import (\n",
    "    DurationRiskEngine,\n",
    "    LoanTerms,\n",
    "    YieldCurve,\n",
    "    AssetLiabilityPosition\n",
    ")\n",
    "from duration_risk_modeling.config import DurationRiskConfig\n",
    "\n",
    "# Set up plotting style\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sns.set_palette(\"husl\")\n",
    "np.random.seed(42)  # For reproducible results"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Initialize the Duration Risk Modeling Engine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create configuration\n",
    "config = DurationRiskConfig()\n",
    "\n",
    "# Customize parameters for demo\n",
    "config.monte_carlo_simulations = 5000  # Reduced for demo performance\n",
    "config.parallel_processing = True\n",
    "config.enable_duration_hedging = True\n",
    "\n",
    "# Initialize the engine\n",
    "duration_engine = DurationRiskEngine(config)\n",
    "\n",
    "print(\"Duration Risk Modeling Engine initialized successfully!\")\n",
    "print(f\"Configuration: {len(config.term_structure.standard_terms)} standard terms\")\n",
    "print(f\"Stress scenarios: {len(config.stress_test_scenarios)}\")\n",
    "print(f\"Monte Carlo simulations: {config.monte_carlo_simulations:,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Create Sample Loan Terms\n",
    "\n",
    "Let's create various loan terms to demonstrate different duration risk profiles."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Short-term loan (3 months)\n",
    "short_term_loan = LoanTerms(\n",
    "    principal_amount=Decimal('50000'),\n",
    "    term_days=90,\n",
    "    interest_rate=Decimal('0.045'),\n",
    "    collateral_type=\"ALGO\",\n",
    "    collateral_amount=Decimal('75000'),\n",
    "    ltv_ratio=0.67,\n",
    "    payment_frequency=\"monthly\"\n",
    ")\n",
    "\n",
    "# Medium-term loan (1 year)\n",
    "medium_term_loan = LoanTerms(\n",
    "    principal_amount=Decimal('200000'),\n",
    "    term_days=365,\n",
    "    interest_rate=Decimal('0.055'),\n",
    "    collateral_type=\"ALGO\",\n",
    "    collateral_amount=Decimal('300000'),\n",
    "    ltv_ratio=0.67,\n",
    "    payment_frequency=\"quarterly\"\n",
    ")\n",
    "\n",
    "# Long-term loan (3 years)\n",
    "long_term_loan = LoanTerms(\n",
    "    principal_amount=Decimal('500000'),\n",
    "    term_days=1095,\n",
    "    interest_rate=Decimal('0.075'),\n",
    "    collateral_type=\"ALGO\",\n",
    "    collateral_amount=Decimal('750000'),\n",
    "    ltv_ratio=0.67,\n",
    "    payment_frequency=\"quarterly\",\n",
    "    prepayment_allowed=True,\n",
    "    early_termination_penalty=Decimal('0.02')\n",
    ")\n",
    "\n",
    "loan_terms_list = [\n",
    "    (\"Short Term (90 days)\", short_term_loan),\n",
    "    (\"Medium Term (1 year)\", medium_term_loan),\n",
    "    (\"Long Term (3 years)\", long_term_loan)\n",
    "]\n",
    "\n",
    "print(\"Created loan terms:\")\n",
    "for name, terms in loan_terms_list:\n",
    "    print(f\"{name}: {terms.principal_amount:,} @ {terms.interest_rate:.1%}, LTV {terms.ltv_ratio:.0%}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Create Market Rate Scenarios\n",
    "\n",
    "Let's define different yield curve scenarios to test duration sensitivity."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Normal yield curve (upward sloping)\n",
    "normal_rates = {\n",
    "    30: Decimal('0.02'),\n",
    "    90: Decimal('0.025'),\n",
    "    180: Decimal('0.03'),\n",
    "    365: Decimal('0.035'),\n",
    "    730: Decimal('0.045'),\n",
    "    1095: Decimal('0.055')\n",
    "}\n",
    "\n",
    "# Flat yield curve\n",
    "flat_rates = {\n",
    "    30: Decimal('0.035'),\n",
    "    90: Decimal('0.035'),\n",
    "    180: Decimal('0.035'),\n",
    "    365: Decimal('0.035'),\n",
    "    730: Decimal('0.035'),\n",
    "    1095: Decimal('0.035')\n",
    "}\n",
    "\n",
    "# Inverted yield curve\n",
    "inverted_rates = {\n",
    "    30: Decimal('0.06'),\n",
    "    90: Decimal('0.055'),\n",
    "    180: Decimal('0.05'),\n",
    "    365: Decimal('0.045'),\n",
    "    730: Decimal('0.04'),\n",
    "    1095: Decimal('0.035')\n",
    "}\n",
    "\n",
    "# Steep yield curve\n",
    "steep_rates = {\n",
    "    30: Decimal('0.015'),\n",
    "    90: Decimal('0.02'),\n",
    "    180: Decimal('0.03'),\n",
    "    365: Decimal('0.05'),\n",
    "    730: Decimal('0.07'),\n",
    "    1095: Decimal('0.09')\n",
    "}\n",
    "\n",
    "rate_scenarios = [\n",
    "    (\"Normal\", normal_rates),\n",
    "    (\"Flat\", flat_rates),\n",
    "    (\"Inverted\", inverted_rates),\n",
    "    (\"Steep\", steep_rates)\n",
    "]\n",
    "\n",
    "print(\"Created yield curve scenarios:\")\n",
    "for name, rates in rate_scenarios:\n",
    "    spread = float(rates[1095] - rates[30])\n",
    "    print(f\"{name}: 30d={rates[30]:.1%}, 1yr={rates[365]:.1%}, 3yr={rates[1095]:.1%} (spread: {spread:.1%})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Visualize Yield Curves"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot yield curves\n",
    "plt.figure(figsize=(12, 8))\n",
    "\n",
    "terms = list(normal_rates.keys())\n",
    "term_years = [t/365.25 for t in terms]\n",
    "\n",
    "for name, rates in rate_scenarios:\n",
    "    yields = [float(rates[t]) * 100 for t in terms]  # Convert to percentage\n",
    "    plt.plot(term_years, yields, marker='o', linewidth=2, label=name)\n",
    "\n",
    "plt.xlabel('Term (Years)')\n",
    "plt.ylabel('Yield Rate (%)')\n",
    "plt.title('Yield Curve Scenarios')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Calculate yield curve statistics\n",
    "curve_stats = []\n",
    "for name, rates in rate_scenarios:\n",
    "    rates_list = [float(r) for r in rates.values()]\n",
    "    curve_stats.append({\n",
    "        'Scenario': name,\n",
    "        'Average': np.mean(rates_list),\n",
    "        'Std Dev': np.std(rates_list),\n",
    "        'Min': np.min(rates_list),\n",
    "        'Max': np.max(rates_list),\n",
    "        'Spread': np.max(rates_list) - np.min(rates_list)\n",
    "    })\n",
    "\n",
    "curve_df = pd.DataFrame(curve_stats)\n",
    "print(\"\\nYield Curve Statistics:\")\n",
    "print(curve_df.round(4))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Market Conditions and Borrower Profiles\n",
    "\n",
    "Define market conditions and borrower profiles for comprehensive analysis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Market condition scenarios\n",
    "market_scenarios = {\n",
    "    'Normal': {\n",
    "        'volatility': 0.25,\n",
    "        'risk_free_rate': 0.03,\n",
    "        'liquidity': 0.85,\n",
    "        'correlation': 0.3\n",
    "    },\n",
    "    'Low Volatility': {\n",
    "        'volatility': 0.15,\n",
    "        'risk_free_rate': 0.025,\n",
    "        'liquidity': 0.95,\n",
    "        'correlation': 0.2\n",
    "    },\n",
    "    'High Volatility': {\n",
    "        'volatility': 0.55,\n",
    "        'risk_free_rate': 0.04,\n",
    "        'liquidity': 0.6,\n",
    "        'correlation': 0.7\n",
    "    }\n",
    "}\n",
    "\n",
    "# Borrower profile scenarios\n",
    "borrower_profiles = {\n",
    "    'Conservative': {\n",
    "        'staking_participation': True,\n",
    "        'high_activity': False,\n",
    "        'governance_locked': True\n",
    "    },\n",
    "    'Active': {\n",
    "        'staking_participation': True,\n",
    "        'high_activity': True,\n",
    "        'governance_locked': False\n",
    "    },\n",
    "    'Basic': {\n",
    "        'staking_participation': False,\n",
    "        'high_activity': False,\n",
    "        'governance_locked': False\n",
    "    }\n",
    "}\n",
    "\n",
    "print(\"Market Scenarios:\")\n",
    "for name, conditions in market_scenarios.items():\n",
    "    print(f\"{name}: Vol={conditions['volatility']:.1%}, Liquidity={conditions['liquidity']:.0%}\")\n",
    "\n",
    "print(\"\\nBorrower Profiles:\")\n",
    "for name, profile in borrower_profiles.items():\n",
    "    features = [k for k, v in profile.items() if v]\n",
    "    print(f\"{name}: {', '.join(features) if features else 'No special features'}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Run Comprehensive Duration Risk Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "async def run_duration_analysis():\n",
    "    \"\"\"Run comprehensive duration risk analysis.\"\"\"\n",
    "    results = []\n",
    "    \n",
    "    # Sample portfolio context\n",
    "    portfolio_context = [\n",
    "        AssetLiabilityPosition(\n",
    "            position_id=\"asset_001\",\n",
    "            asset_type=\"loan\",\n",
    "            notional_amount=Decimal('300000'),\n",
    "            duration=2.5,\n",
    "            yield_rate=Decimal('0.06'),\n",
    "            maturity_bucket=\"medium\",\n",
    "            weight_in_portfolio=0.4\n",
    "        ),\n",
    "        AssetLiabilityPosition(\n",
    "            position_id=\"liability_001\",\n",
    "            asset_type=\"deposit\",\n",
    "            notional_amount=Decimal('450000'),\n",
    "            duration=0.8,\n",
    "            yield_rate=Decimal('0.025'),\n",
    "            maturity_bucket=\"short\",\n",
    "            weight_in_portfolio=0.6\n",
    "        )\n",
    "    ]\n",
    "    \n",
    "    # Run analysis for each combination\n",
    "    for loan_name, loan_terms in loan_terms_list:\n",
    "        for scenario_name, market_rates in rate_scenarios[:2]:  # Use first 2 scenarios for demo\n",
    "            for market_name, market_conditions in list(market_scenarios.items())[:2]:  # Use first 2 markets\n",
    "                for profile_name, borrower_profile in list(borrower_profiles.items())[:2]:  # Use first 2 profiles\n",
    "                    \n",
    "                    try:\n",
    "                        assessment = await duration_engine.analyze_duration_risk(\n",
    "                            loan_terms=loan_terms,\n",
    "                            market_rates=market_rates,\n",
    "                            market_conditions=market_conditions,\n",
    "                            borrower_profile=borrower_profile,\n",
    "                            portfolio_context=portfolio_context\n",
    "                        )\n",
    "                        \n",
    "                        results.append({\n",
    "                            'loan_type': loan_name,\n",
    "                            'yield_scenario': scenario_name,\n",
    "                            'market_conditions': market_name,\n",
    "                            'borrower_profile': profile_name,\n",
    "                            'assessment': assessment\n",
    "                        })\n",
    "                        \n",
    "                    except Exception as e:\n",
    "                        print(f\"Error in analysis: {e}\")\n",
    "                        continue\n",
    "    \n",
    "    return results\n",
    "\n",
    "# Run the analysis\n",
    "print(\"Running comprehensive duration risk analysis...\")\n",
    "analysis_results = await run_duration_analysis()\n",
    "print(f\"Completed {len(analysis_results)} duration risk assessments\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Analyze and Visualize Results"
