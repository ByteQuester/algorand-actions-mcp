   "source": [
    "# Create results DataFrame\n",
    "results_data = []\n",
    "\n",
    "for result in analysis_results:\n",
    "    assessment = result['assessment']\n",
    "    duration_metrics = assessment.term_structure_analysis.duration_metrics\n",
    "    prepayment_model = assessment.term_structure_analysis.prepayment_model\n",
    "    \n",
    "    results_data.append({\n",
    "        'Loan_Type': result['loan_type'],\n",
    "        'Yield_Scenario': result['yield_scenario'],\n",
    "        'Market_Conditions': result['market_conditions'],\n",
    "        'Borrower_Profile': result['borrower_profile'],\n",
    "        'Modified_Duration': duration_metrics.modified_duration,\n",
    "        'Macaulay_Duration': duration_metrics.macaulay_duration,\n",
    "        'Effective_Duration': duration_metrics.effective_duration,\n",
    "        'Convexity': duration_metrics.convexity,\n",
    "        'Duration_Bucket': duration_metrics.duration_bucket,\n",
    "        'Prepayment_Probability': prepayment_model.adjusted_prepayment_probability,\n",
    "        'Expected_Prepayment_Days': prepayment_model.expected_prepayment_time,\n",
    "        'Duration_Risk_Score': assessment.duration_risk_score,\n",
    "        'AL_Mismatch': assessment.asset_liability_mismatch,\n",
    "        'Duration_Premium': float(assessment.final_duration_premium),\n",
    "        'Basis_Point_Value': float(duration_metrics.basis_point_value)\n",
    "    })\n",
    "\n",
    "duration_df = pd.DataFrame(results_data)\n",
    "print(\"Duration Analysis Results DataFrame:\")\n",
    "print(duration_df.head())\n",
    "print(f\"\\nShape: {duration_df.shape}\")"
   ]
