   "outputs": [],
   "source": [
    "# Analyze impact of different market scenarios\n",
    "scenario_impact = duration_df.groupby(['Yield_Scenario', 'Market_Conditions']).agg({\n",
    "    'Modified_Duration': 'mean',\n",
    "    'Duration_Risk_Score': 'mean',\n",
    "    'Duration_Premium': 'mean',\n",
    "    'Prepayment_Probability': 'mean'\n",
    "}).round(3)\n",
    "\n",
    "print(\"Market Scenario Impact Analysis:\")\n",
    "print(scenario_impact)\n",
    "\n",
    "# Heatmap of duration premium by scenarios\n",
    "plt.figure(figsize=(12, 8))\n",
    "\n",
    "# Pivot for heatmap\n",
    "heatmap_data = duration_df.pivot_table(\n",
    "    values='Duration_Premium', \n",
    "    index='Yield_Scenario', \n",
    "    columns='Market_Conditions', \n",
    "    aggfunc='mean'\n",
    ")\n",
    "\n",
    "sns.heatmap(heatmap_data, annot=True, fmt='.4f', cmap='YlOrRd', \n",
    "            cbar_kws={'label': 'Duration Premium'})\n",
    "plt.title('Duration Premium by Yield Scenario and Market Conditions')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
