    "## 6. Stress Testing Analysis\n",
    "\n",
    "Perform stress testing under various market scenarios."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define stress testing scenarios\n",
    "stress_scenarios = {\n",
    "    'Market Crash -30%': {'price_multiplier': 0.7, 'volatility_multiplier': 1.5},\n",
    "    'Flash Crash -50%': {'price_multiplier': 0.5, 'volatility_multiplier': 2.0},\n",
    "    'Bull Run +20%': {'price_multiplier': 1.2, 'volatility_multiplier': 0.8},\n",
    "    'Extreme Volatility': {'price_multiplier': 1.0, 'volatility_multiplier': 3.0}\n",
    "}\n",
    "\n",
    "def create_stress_portfolio(base_portfolio, scenario):\n",
    "    \"\"\"Create a stress-tested version of the portfolio\"\"\"\n",
    "    stress_portfolio = {\n",
    "        'address': base_portfolio['address'],\n",
    "        'assets': {},\n",
    "        'market_conditions': base_portfolio.get('market_conditions', {})\n",
    "    }\n",
    "    \n",
    "    # Apply stress factors to assets\n",
    "    for symbol, asset_data in base_portfolio['assets'].items():\n",
    "        stressed_asset = asset_data.copy()\n",
    "        stressed_asset['current_price'] *= scenario['price_multiplier']\n",
    "        stressed_asset['volatility_30d'] = min(\n",
    "            stressed_asset['volatility_30d'] * scenario['volatility_multiplier'], 1.0\n",
    "        )\n",
    "        stress_portfolio['assets'][symbol] = stressed_asset\n",
    "    \n",
    "    return stress_portfolio\n",
    "\n",
    "async def run_stress_testing():\n",
    "    \"\"\"Run stress testing analysis\"\"\"\n",
    "    stress_results = {}\n",
    "    \n",
    "    for scenario_name, scenario_params in stress_scenarios.items():\n",
    "        print(f\"\\n🧪 Running stress test: {scenario_name}\")\n",
    "        scenario_results = {}\n",
    "        \n",
    "        for portfolio_name, base_portfolio in portfolios.items():\n",
    "            try:\n",
    "                # Create stressed portfolio\n",
    "                stress_portfolio = create_stress_portfolio(base_portfolio, scenario_params)\n",
    "                \n",
    "                # Run smart collateral analysis on stressed portfolio\n",
    "                stress_analysis = await smart_analyzer.analyze_smart_collateral(\n",
    "                    collateral_portfolio=stress_portfolio\n",
    "                )\n",
    "                \n",
    "                scenario_results[portfolio_name] = {\n",
    "                    'stressed_value': stress_analysis.total_collateral_value,\n",
    "                    'quality_score': stress_analysis.quality_metrics.overall_quality_score,\n",
    "                    'confidence': stress_analysis.confidence_level,\n",
    "                    'value_change': (\n",
    "                        stress_analysis.total_collateral_value / portfolio_values[portfolio_name] - 1\n",
    "                    ) if portfolio_values[portfolio_name] > 0 else 0\n",
    "                }\n",
    "                \n",
    "                print(f\"   {portfolio_name}: {scenario_results[portfolio_name]['value_change']:.1%} value change\")\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"   {portfolio_name}: Error - {str(e)}\")\n",
    "        \n",
    "        stress_results[scenario_name] = scenario_results\n",
    "    \n",
    "    return stress_results\n",
    "\n",
    "# Run stress testing\n",
    "stress_results = await run_stress_testing()\n",
    "\n",
    "print(f\"\\n📊 Completed stress testing across {len(stress_scenarios)} scenarios\")"
   ]
