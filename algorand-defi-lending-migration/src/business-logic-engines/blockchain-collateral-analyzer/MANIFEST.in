# Include the README and other documentation files
include README.md
include LICENSE
include CHANGELOG.md
include requirements.txt
include requirements-dev.txt
include pyproject.toml

# Include configuration files
recursive-include */ *.yaml
recursive-include */ *.yml
recursive-include */ *.json
recursive-include */ *.toml
recursive-include */ *.cfg
recursive-include */ *.ini

# Include data files and configs for each engine
recursive-include digital-asset-valuation/config *.yaml *.yml *.json
recursive-include volatility-assessment/config *.yaml *.yml *.json
recursive-include liquidation-scenarios/config *.yaml *.yml *.json
recursive-include oracle-price-integration/config *.yaml *.yml *.json
recursive-include portfolio-diversification/config *.yaml *.yml *.json
recursive-include collateral-requirements/config *.yaml *.yml *.json
recursive-include common/config *.yaml *.yml *.json

# Include templates and data files
recursive-include */templates *
recursive-include */data *.json *.csv *.yaml *.yml
recursive-include */schemas *.json *.yaml *.yml

# Include test data
recursive-include */test_data *.json *.yaml *.yml *.csv

# Include shell scripts
include *.sh
recursive-include scripts *.sh *.py

# Include CLI module files
recursive-include cli *.py

# Exclude development and testing files
exclude .gitignore
exclude .pre-commit-config.yaml
exclude *.pyc
exclude */__pycache__/*
exclude */tests/*
exclude integration_tests/*
exclude notebooks/*
exclude learning-path/*
exclude *.egg-info/*
exclude build/*
exclude dist/*
exclude .pytest_cache/*
exclude .mypy_cache/*
exclude .coverage
exclude htmlcov/*

# Exclude IDE files
exclude .vscode/*
exclude .idea/*
exclude *.swp
exclude *.swo
exclude *~

# Exclude OS files
exclude .DS_Store
exclude Thumbs.db