# Environment configuration for algorand-lending-core
# Copy this to .env and customize as needed

# MCP Service Endpoints
LENDING_READER_ENDPOINT=http://localhost:8002
LENDING_WRITER_ENDPOINT=http://localhost:3001

# Service Configuration
LENDING_TIMEOUT_SECONDS=30
LENDING_RETRY_COUNT=3

# Algorand Network Configuration
ALGORAND_NETWORK=testnet

# Lending Business Logic Configuration
LOAN_AMOUNT_LIMIT=1000000      # Maximum loan amount in microAlgos
COLLATERAL_RATIO=150           # Required collateral percentage
INTEREST_RATE=5.0              # Annual interest rate percentage
MIN_LOAN_DURATION=86400        # Minimum loan duration in seconds (1 day)
MAX_LOAN_DURATION=31536000     # Maximum loan duration in seconds (1 year)

# Debug and Development
LENDING_DEBUG=false            # Enable debug logging
NODE_ENV=development           # development, production, test