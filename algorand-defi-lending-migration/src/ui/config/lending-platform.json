{
  "platform": {
    "name": "Algorand Lending Platform",
    "subtitle": "Decentralized Lending on Algorand",
    "description": "Professional lending platform built on Algorand blockchain",
    "version": "1.0.0"
  },
  "branding": {
    "primary_color": "#0066CC",
    "secondary_color": "#00A86B",
    "accent_color": "#FFA500",
    "background_color": "#F8F9FA",
    "text_color": "#212529",
    "logo_path": "/assets/lending-logo.png",
    "favicon_path": "/assets/favicon.ico",
    "theme": "lending-blue"
  },
  "ui": {
    "landing_page": "/components/lending-dashboard.html",
    "show_adk_branding": false,
    "custom_navigation": true,
    "simplified_interface": true,
    "hide_developer_tools": true
  },
  "navigation": [
    {
      "name": "Request Loan",
      "path": "/lending/request",
      "icon": "💰",
      "description": "Submit a new loan application",
      "agents": ["hello_world"],
      "action": "loan_request"
    },
    {
      "name": "Check Status",
      "path": "/lending/status",
      "icon": "📊",
      "description": "Monitor your loan applications",
      "agents": ["hello_world"],
      "action": "loan_status"
    },
    {
      "name": "My Account",
      "path": "/account",
      "icon": "💼",
      "description": "Manage your wallet and account",
      "agents": ["a2a_auth", "hello_world"],
      "action": "account_balance"
    }
  ],
  "dashboard": {
    "sections": [
      {
        "name": "Quick Actions",
        "type": "actions",
        "widgets": [
          {
            "type": "loan_request",
            "title": "Request Loan",
            "description": "Apply for a new loan",
            "action": "request_loan",
            "agent": "hello_world"
          },
          {
            "type": "loan_status",
            "title": "Check Status",
            "description": "View loan status",
            "action": "check_status",
            "agent": "hello_world"
          },
          {
            "type": "account_balance",
            "title": "My Balance",
            "description": "Check wallet balance",
            "action": "view_balance",
            "agent": "hello_world"
          }
        ]
      },
      {
        "name": "Account Overview",
        "type": "stats",
        "widgets": [
          {
            "type": "metric",
            "title": "Active Loans",
            "value": "0",
            "format": "number"
          },
          {
            "type": "metric",
            "title": "Available Balance",
            "value": "-- ALGO",
            "format": "currency"
          },
          {
            "type": "metric",
            "title": "Interest Earned",
            "value": "0 ALGO",
            "format": "currency"
          },
          {
            "type": "status",
            "title": "Platform Status",
            "value": "Operational",
            "format": "status"
          }
        ]
      }
    ]
  },
  "integrations": {
    "adk_web_base_url": "http://localhost:8081",
    "lending_api_base_url": "http://localhost:8003",
    "mcp_services": {
      "reader": "http://localhost:8002",
      "writer": "http://localhost:3001"
    }
  },
  "deployment": {
    "production_mode": false,
    "environment": "development",
    "debug": true,
    "analytics_enabled": false
  }
}