# Environment Configuration for @algorand-showcase/config
# Copy this to .env and customize for your environment

# Network Configuration
ALGORAND_NETWORK=testnet  # mainnet, testnet, betanet
ALLOW_MAINNET=false       # true/false - whether to allow mainnet operations

# Custom Algorand Node URLs (optional - defaults to AlgoNode public endpoints)
# CUSTOM_ALGOD_URL=https://your-custom-algod-node.com
# CUSTOM_INDEXER_URL=https://your-custom-indexer-node.com

# Development Overrides
# DEV_ALGOD_URL=http://localhost:4001        # Local algod for development
# DEV_INDEXER_URL=http://localhost:8980      # Local indexer for development

# Pera Wallet Explorer URLs (optional - defaults based on network)
# CUSTOM_EXPLORER_BASE_URL=https://your-custom-explorer.com

# Environment Mode
NODE_ENV=development  # development, production, test