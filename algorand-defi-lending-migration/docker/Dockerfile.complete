# Complete Dockerfile for Algorand DeFi Lending Platform
# Production-ready multi-stage build with all components

FROM python:3.10-slim as python-base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Node.js stage for MCP services
FROM node:18-alpine as node-builder

WORKDIR /app

# Copy package files
COPY src/packages/package.json src/packages/pnpm-lock.yaml* ./packages/
COPY src/mcp-services/*/package.json ./mcp-services/

# Install dependencies
RUN npm install -g pnpm
RUN cd packages && pnpm install --frozen-lockfile

# Copy source code
COPY src/packages ./packages
COPY src/mcp-services ./mcp-services

# Build packages
RUN cd packages && pnpm run build
RUN cd mcp-services && for service in */; do cd "$service" && pnpm run build && cd ..; done

# Final production stage
FROM python-base as production

# Copy Python dependencies from base stage
COPY --from=python-base /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=python-base /usr/local/bin /usr/local/bin

# Install Node.js for MCP services
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm

# Copy built Node.js applications
COPY --from=node-builder /app/packages/dist ./packages/dist
COPY --from=node-builder /app/mcp-services ./mcp-services
COPY --from=node-builder /app/packages/node_modules ./packages/node_modules

# Copy Python source code
COPY src/ ./src/
COPY tests/ ./tests/
COPY config/ ./config/
COPY database/ ./database/

# Create necessary directories
RUN mkdir -p /app/data /app/logs /app/uploads

# Set ownership
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

# Environment variables
ENV NODE_ENV=production
ENV PYTHONPATH=/app/src
ENV PORT=8080
ENV LOG_LEVEL=info

# Expose ports
EXPOSE 8080 8001 8002

# Entry point script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["api"]