{
  "name": "@algorand-showcase/packages",
  "version": "0.1.0",
  "description": "Shared packages for Algorand MCP Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:py --if-present",
    "build:ts": "pnpm --filter='!@algorand-showcase/lending-*' run build",
    "build:py": "echo 'Python packages: use pip install -e . for development builds'",
    "clean": "pnpm -r run clean",
    "type-check": "pnpm --filter='!@algorand-showcase/lending-*' run type-check",
    "dev": "pnpm -r run dev --if-present",
    "test": "pnpm -r run test --if-present",
    "lint": "pnpm -r run lint --if-present",
    "format": "pnpm -r run format --if-present",
    "validate": "pnpm run type-check && pnpm run lint",
    "setup-dev": "pnpm -r run setup-dev --if-present"
  },
  "workspaces": [
    "types",
    "config",
    "algorand-clients",
    "mcp-core",
    "lending-api",
    "lending-core"
  ],
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}