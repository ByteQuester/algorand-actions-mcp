{
  "name": "@algorand-showcase/lending-core",
  "version": "1.0.0",
  "description": "Pure business logic for Algorand A2A lending",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python setup.py build",
    "clean": "rm -rf build/ dist/ *.egg-info/ src/__pycache__/ src/**/__pycache__/",
    "dev": "echo 'Python package - use pip install -e . for development'",
    "test": "python -m pytest tests/ --if-present",
    "setup-dev": "cp config/.env.example .env || echo '.env already exists'",
    "validate": "python -m py_compile src/*.py",
    "install-dev": "pip install -e .",
    "config-test": "python scripts/dev/config_helper.py test"
  },
  "files": [
    "src/**/*",
    "README.md",
    "setup.py"
  ],
  "keywords": [
    "algorand",
    "lending",
    "defi",
    "python"
  ],
  "python": {
    "requires": ">=3.8",
    "main": "src"
  }
}