{
  "name": "@algorand-showcase/lending-api",
  "version": "1.0.0",
  "description": "FastAPI wrapper for algorand-lending-core",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python setup.py build",
    "clean": "rm -rf build/ dist/ *.egg-info/ src/__pycache__/ src/**/__pycache__/",
    "dev": "uvicorn src.server:app --reload --host 0.0.0.0 --port 8000",
    "start": "uvicorn src.server:app --host 0.0.0.0 --port 8000",
    "test": "python -m pytest tests/ --if-present",
    "setup-dev": "cp config/.env.example .env || echo '.env already exists'",
    "validate": "python -m py_compile src/*.py",
    "install-dev": "pip install -e ."
  },
  "files": [
    "src/**/*",
    "README.md",
    "setup.py"
  ],
  "keywords": [
    "algorand",
    "lending",
    "fastapi",
    "api",
    "python"
  ],
  "python": {
    "requires": ">=3.8",
    "main": "src"
  },
  "dependencies": {
    "@algorand-showcase/lending-core": "workspace:*"
  }
}