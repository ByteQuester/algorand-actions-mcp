# Environment Configuration Template
# Copy this file to .env.development or .env.production and fill in values

# Environment
NODE_ENV=development  # development | production | test

# Google API Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE  # TRUE for production with Vertex AI

# Google Model Configuration
GOOGLE_MODEL_NAME=gemini-2.0-flash-exp

# MCP Service Endpoints
ALGORAND_READER_ENDPOINT=http://localhost:8002
ALGORAND_WRITER_ENDPOINT=http://localhost:3001
LENDING_TOOLBOX_ENDPOINT=http://127.0.0.1:5001

# Database Configuration (Production)
DATABASE_TYPE=postgresql  # sqlite | postgresql | mysql
DATABASE_URL=postgresql://user:password@localhost:5432/lending_platform

# Security (Production)
JWT_SECRET=your_super_secure_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=3600

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=structured  # simple | structured | json

# Server Configuration
PORT=8003
HOST=0.0.0.0

# ADK Web Configuration
ADK_WEB_BASE_URL=http://localhost:3000
ADK_WEB_PORT=3000

# Data Storage
LOAN_DATA_DIR=./data
BACKUP_DIR=./backups

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Rate Limiting (Production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# CORS (Production)
CORS_ENABLED=true
CORS_ORIGIN=https://your-frontend-domain.com