# Environment configuration for algorand-lending-api
# Copy this to .env and customize as needed

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# CORS Configuration
CORS_ORIGINS=http://localhost:8000,http://localhost:8081,http://localhost:3000

# Lending Core Dependencies
LENDING_READER_ENDPOINT=http://localhost:8002
LENDING_WRITER_ENDPOINT=http://localhost:3001
LENDING_TIMEOUT_SECONDS=30
LENDING_RETRY_COUNT=3

# Algorand Network Configuration
ALGORAND_NETWORK=testnet

# ADK Web Integration
ADK_WEB_BASE_URL=http://localhost:8000

# API Security
API_KEY_HEADER=X-API-Key
# API_KEY=your-secret-api-key  # Uncomment and set for production

# Database Configuration (if using persistent storage)
# DATABASE_URL=sqlite:///./lending.db
# DATABASE_POOL_SIZE=5

# Logging Configuration
LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json               # json, text

# Environment Mode
NODE_ENV=development          # development, production, test