{
  "name": "algorand-adk-lending-agents",
  "version": "1.0.0",
  "description": "Google ADK-based lending agents for Algorand blockchain operations",
  "author": "Algorand Showcase Team",
  "license": "Apache-2.0",
  "keywords": ["algorand", "defi", "lending", "agents", "adk", "gemini"],

  "agents": {
    "lending_coordinator": {
      "name": "algorand_lending_coordinator",
      "description": "Master coordination agent for Algorand DeFi lending operations",
      "model": "gemini-2.0-flash-exp",
      "type": "coordinator",
      "file": "coordination/agent.py",
      "manifest": "schemas/agents/lending_coordinator.json",
      "sub_agents": [
        "negotiation_agent",
        "liquidity_agent",
        "execution_agent"
      ],
      "endpoints": {
        "health": "/agents/lending_coordinator/health",
        "process": "/agents/lending_coordinator/process",
        "status": "/agents/lending_coordinator/status"
      },
      "capabilities": [
        "workflow_orchestration",
        "multi_agent_coordination",
        "mcp_integration",
        "error_recovery"
      ]
    },

    "negotiation_agent": {
      "name": "algorand_lending_negotiation_agent",
      "description": "Sophisticated lending negotiation agent with AI-powered decision making",
      "model": "gemini-2.5-flash",
      "type": "specialist",
      "file": "negotiation/agent.py",
      "manifest": "schemas/agents/negotiation_agent.json",
      "tools": [
        "calculate_interest_rate",
        "assess_loan_risk",
        "calculate_collateral_requirement",
        "generate_counter_proposal"
      ],
      "capabilities": [
        "risk_assessment",
        "rate_calculation",
        "term_negotiation",
        "counter_proposals"
      ]
    },

    "liquidity_agent": {
      "name": "algorand_lending_liquidity_agent",
      "description": "Advanced liquidity discovery and matching agent",
      "model": "gemini-2.5-flash",
      "type": "specialist",
      "file": "liquidity/agent.py",
      "manifest": "schemas/agents/liquidity_agent.json",
      "tools": [
        "find_available_lenders",
        "assess_borrower_creditworthiness",
        "match_liquidity_requirements",
        "calculate_liquidity_costs"
      ],
      "capabilities": [
        "lender_discovery",
        "credit_assessment",
        "liquidity_matching",
        "cost_optimization"
      ]
    },

    "execution_agent": {
      "name": "algorand_lending_execution_agent",
      "description": "Expert blockchain execution agent for transaction coordination",
      "model": "gemini-2.5-flash",
      "type": "specialist",
      "file": "execution/agent.py",
      "manifest": "schemas/agents/execution_agent.json",
      "tools": [
        "prepare_transaction_group",
        "validate_execution_requirements",
        "estimate_transaction_costs",
        "create_lending_contract"
      ],
      "capabilities": [
        "transaction_preparation",
        "atomic_groups",
        "cost_estimation",
        "smart_contracts"
      ]
    }
  },

  "workflows": {
    "complete_lending_workflow": {
      "name": "Complete Lending Workflow",
      "description": "End-to-end lending process from request to execution",
      "coordinator": "lending_coordinator",
      "manifest": "schemas/workflows/complete_lending_workflow.json",
      "steps": [
        "health_check",
        "borrower_assessment",
        "liquidity_discovery",
        "term_negotiation",
        "execution_preparation",
        "final_coordination"
      ],
      "estimated_duration": "2-5 minutes",
      "success_criteria": [
        "mcp_services_healthy",
        "borrower_creditworthy",
        "liquidity_available",
        "terms_agreed",
        "execution_ready"
      ]
    }
  },

  "tools": {
    "schemas_directory": "schemas/tools/",
    "total_tools": 16,
    "categories": {
      "negotiation": 4,
      "liquidity": 4,
      "execution": 4,
      "coordination": 4
    }
  },

  "infrastructure": {
    "mcp_services": {
      "algorand_reader": {
        "endpoint": "http://localhost:8002",
        "health": "/health",
        "description": "Algorand blockchain reader service"
      },
      "algorand_writer": {
        "endpoint": "http://localhost:3001",
        "health": "/health",
        "description": "Algorand blockchain writer service"
      }
    },

    "requirements": {
      "python_version": ">=3.8",
      "dependencies": [
        "google-adk>=0.1.0",
        "google-generativeai>=0.5.0",
        "httpx>=0.25.0",
        "python-dotenv>=1.0.0"
      ],
      "environment_variables": [
        "GOOGLE_API_KEY",
        "GOOGLE_GENAI_USE_VERTEXAI"
      ]
    }
  },

  "deployment": {
    "web_ui": {
      "enabled": true,
      "command": "adk web",
      "port": 3000,
      "features": [
        "agent_monitoring",
        "workflow_execution",
        "real_time_status",
        "transaction_tracking"
      ]
    },

    "production": {
      "health_checks": true,
      "logging": "structured",
      "monitoring": "enabled",
      "error_recovery": "automatic"
    }
  },

  "testing": {
    "unit_tests": "test_adk_agents.py",
    "integration_tests": "test_real_mcp.py",
    "demo_scripts": [
      "standalone_demo.py",
      "demo_adk_agents.py"
    ],
    "coverage": {
      "tools": "100%",
      "agents": "100%",
      "workflows": "95%",
      "mcp_integration": "90%"
    }
  },

  "documentation": {
    "readme": "README.md",
    "implementation_guide": "IMPLEMENTATION_SUMMARY.md",
    "api_reference": "schemas/",
    "examples": [
      "standalone_demo.py",
      "test_real_mcp.py"
    ]
  }
}