# Production Environment Template
# CRITICAL: Do not commit this file with real values to version control

NODE_ENV=production

# Google API Configuration - REQUIRED
GOOGLE_API_KEY=REPLACE_WITH_PRODUCTION_GOOGLE_API_KEY
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_MODEL_NAME=gemini-2.0-flash-exp

# MCP Service Endpoints - REQUIRED
ALGORAND_READER_ENDPOINT=https://your-algorand-reader.production.com
ALGORAND_WRITER_ENDPOINT=https://your-algorand-writer.production.com
LENDING_TOOLBOX_ENDPOINT=https://your-lending-toolbox.production.com

# Database Configuration - REQUIRED
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://lending_user:SECURE_PASSWORD@prod-db.example.com:5432/lending_platform

# Security - REQUIRED
JWT_SECRET=REPLACE_WITH_SECURE_64_CHAR_SECRET_KEY_FOR_PRODUCTION_USE_ONLY
JWT_EXPIRY=3600

# Server Configuration
PORT=8003
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=structured

# ADK Web Configuration
ADK_WEB_BASE_URL=https://your-lending-platform.production.com
ADK_WEB_PORT=3000

# Data Storage
LOAN_DATA_DIR=/var/lib/lending-platform/data
BACKUP_DIR=/var/lib/lending-platform/backups

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ENABLED=true
CORS_ORIGIN=https://your-frontend-domain.production.com