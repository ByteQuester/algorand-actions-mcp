{
  "id": "liquidity-agent",
  "name": "Liquidity Discovery Agent",
  "version": "1.0.0",
  "description": "Discovers available liquidity and matches lenders with borrowers",
  "category": "lending",
  "author": "Agent 2 - Lending API Team",

  "purpose": {
    "primary": "Find and match liquidity providers for loan requests",
    "secondary": ["Lender reputation assessment", "Liquidity pool analysis", "Market depth evaluation"]
  },

  "mcp_dependencies": {
    "algorand-reader-mcp": {
      "purpose": "Query blockchain for potential lenders and liquidity pools",
      "endpoints": [
        "GET /accounts/search",
        "GET /accounts/{address}/balance",
        "GET /accounts/{address}/transactions",
        "GET /liquidity/pools",
        "GET /market/depth"
      ],
      "required": true
    },
    "reputation-mcp": {
      "purpose": "Access lender reputation and lending history",
      "endpoints": [
        "GET /lenders/{address}/reputation",
        "GET /lenders/{address}/history",
        "POST /lenders/rank"
      ],
      "required": false,
      "fallback": "Basic on-chain transaction analysis"
    }
  },

  "input_schema": {
    "type": "object",
    "properties": {
      "loan_request": {
        "type": "object",
        "properties": {
          "amount_micro_algos": {"type": "integer", "minimum": 1000000},
          "duration_days": {"type": "integer", "minimum": 1, "maximum": 365},
          "max_interest_rate": {"type": "number", "minimum": 0, "maximum": 100},
          "borrower_address": {"type": "string", "pattern": "^[A-Z0-9]{58}$"},
          "preferred_lenders": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Z0-9]{58}$"}
          }
        },
        "required": ["amount_micro_algos", "duration_days", "max_interest_rate", "borrower_address"]
      },
      "search_criteria": {
        "type": "object",
        "properties": {
          "min_lender_balance": {"type": "integer", "default": 10000000},
          "min_reputation_score": {"type": "integer", "minimum": 0, "maximum": 100, "default": 70},
          "max_lenders_to_evaluate": {"type": "integer", "default": 50},
          "geographic_preference": {"type": "string"},
          "lender_categories": {
            "type": "array",
            "items": {"type": "string", "enum": ["individual", "institution", "pool", "protocol"]}
          }
        }
      }
    },
    "required": ["loan_request"]
  },

  "output_schema": {
    "type": "object",
    "properties": {
      "liquidity_discovery": {
        "type": "object",
        "properties": {
          "total_liquidity_found": {"type": "integer"},
          "suitable_lenders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lender_address": {"type": "string"},
                "available_amount": {"type": "integer"},
                "interest_rate_offered": {"type": "number"},
                "reputation_score": {"type": "integer"},
                "lending_history_count": {"type": "integer"},
                "response_time_avg_hours": {"type": "number"},
                "specializes_in": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "best_match": {
            "type": "object",
            "properties": {
              "lender_address": {"type": "string"},
              "match_score": {"type": "number", "minimum": 0, "maximum": 100},
              "recommended_terms": {"type": "object"}
            }
          }
        }
      },
      "market_analysis": {
        "type": "object",
        "properties": {
          "liquidity_depth": {"type": "string", "enum": ["low", "medium", "high"]},
          "average_interest_rate": {"type": "number"},
          "market_trend": {"type": "string", "enum": ["tightening", "stable", "loosening"]},
          "competition_level": {"type": "string", "enum": ["low", "medium", "high"]}
        }
      }
    },
    "required": ["liquidity_discovery"]
  },

  "workflow": [
    {
      "step": 1,
      "name": "analyze_loan_requirements",
      "description": "Parse loan request and determine search parameters",
      "logic": "Extract amount, duration, and borrower risk profile"
    },
    {
      "step": 2,
      "name": "scan_blockchain",
      "description": "Search for accounts with sufficient ALGO balance",
      "mcp_calls": ["algorand-reader-mcp:/accounts/search?min_balance={amount}"]
    },
    {
      "step": 3,
      "name": "evaluate_lenders",
      "description": "Assess potential lenders by balance, history, and reputation",
      "mcp_calls": ["algorand-reader-mcp:/accounts/{address}/transactions", "reputation-mcp:/lenders/{address}/reputation"]
    },
    {
      "step": 4,
      "name": "rank_by_suitability",
      "description": "Score and rank lenders based on loan fit and reliability",
      "logic": "Multi-factor scoring: balance, reputation, interest rate, response time"
    },
    {
      "step": 5,
      "name": "analyze_market_conditions",
      "description": "Assess overall liquidity market depth and trends",
      "mcp_calls": ["algorand-reader-mcp:/market/depth", "algorand-reader-mcp:/liquidity/pools"]
    }
  ],

  "scoring_algorithm": {
    "lender_suitability": {
      "balance_adequacy": 0.30,
      "reputation_score": 0.25,
      "interest_competitiveness": 0.20,
      "response_time": 0.15,
      "lending_experience": 0.10
    },
    "market_conditions": {
      "liquidity_depth_weight": 0.40,
      "interest_rate_trends": 0.35,
      "lender_competition": 0.25
    }
  },

  "error_handling": {
    "insufficient_liquidity": {
      "code": "NO_LIQUIDITY_FOUND",
      "message": "No lenders found with sufficient balance and suitable terms",
      "recovery": "Suggest alternative loan amounts or extended search criteria"
    },
    "blockchain_query_failed": {
      "code": "BLOCKCHAIN_QUERY_ERROR",
      "message": "Unable to query blockchain for lender data",
      "recovery": "Retry with cached data or fallback to known lender list"
    },
    "reputation_service_down": {
      "code": "REPUTATION_SERVICE_UNAVAILABLE",
      "message": "Lender reputation service unavailable",
      "recovery": "Use on-chain transaction analysis as reputation proxy"
    }
  },

  "performance_targets": {
    "response_time_ms": 3000,
    "success_rate_percent": 90,
    "lender_discovery_rate": 75
  },

  "deployment": {
    "runtime": "python",
    "dependencies": ["lending-core>=1.0.0", "algorand-sdk>=2.0.0"],
    "config_required": ["search_radius", "reputation_weights", "market_analysis_enabled"],
    "health_check": "/agents/liquidity/health"
  }
}