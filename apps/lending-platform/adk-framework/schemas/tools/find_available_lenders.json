{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Find Available Lenders Tool",
  "description": "Discovers and matches suitable lenders for borrowing requests",
  "type": "object",

  "tool_metadata": {
    "name": "find_available_lenders",
    "version": "1.0.0",
    "category": "liquidity",
    "complexity": "high",
    "execution_time_estimate": "500-2000ms",
    "external_dependencies": ["market_data", "lender_registry"],
    "created": "2025-09-14"
  },

  "input_schema": {
    "type": "object",
    "required": ["loan_amount_algos", "target_interest_rate", "duration_days"],
    "properties": {
      "loan_amount_algos": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 100000,
        "description": "Required loan amount in ALGO"
      },
      "target_interest_rate": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 50,
        "description": "Target interest rate percentage"
      },
      "duration_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365,
        "description": "Loan duration in days"
      },
      "borrower_risk_category": {
        "type": "string",
        "enum": ["LOW", "MEDIUM", "HIGH", "VERY_HIGH"],
        "default": "MEDIUM",
        "description": "Borrower's risk category"
      },
      "preferred_lender_types": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["institutional", "private", "community", "protocol"]
        },
        "default": ["institutional", "private", "community", "protocol"],
        "description": "Preferred types of lenders"
      },
      "max_lenders_to_return": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 10,
        "description": "Maximum number of lenders to return"
      }
    },
    "additionalProperties": false
  },

  "output_schema": {
    "type": "object",
    "required": ["total_lenders_found", "available_lenders", "rate_range", "market_depth"],
    "properties": {
      "total_lenders_found": {
        "type": "integer",
        "minimum": 0,
        "description": "Total number of suitable lenders found"
      },
      "available_lenders": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["lender_id", "name", "type", "offered_interest_rate", "available_capacity_algos"],
          "properties": {
            "lender_id": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$",
              "description": "Unique lender identifier"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Lender name or organization"
            },
            "type": {
              "type": "string",
              "enum": ["institutional", "private", "community", "protocol"]
            },
            "available_capacity_algos": {
              "type": "number",
              "minimum": 0,
              "description": "Available lending capacity in ALGO"
            },
            "offered_interest_rate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 50,
              "description": "Interest rate offered by lender"
            },
            "max_duration_days": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum loan duration supported"
            },
            "reputation_score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Lender reputation score"
            },
            "active_loans": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of currently active loans"
            },
            "estimated_approval_time": {
              "type": "string",
              "pattern": "^\\d+-\\d+ (minutes|hours)$",
              "description": "Estimated time for loan approval"
            },
            "special_terms": {
              "type": "object",
              "properties": {
                "early_repayment": {"type": "boolean"},
                "rate_negotiable": {"type": "boolean"},
                "collateral_flexibility": {"type": "boolean"}
              }
            }
          }
        },
        "description": "List of available lenders sorted by best terms"
      },
      "total_available_capacity": {
        "type": "number",
        "minimum": 0,
        "description": "Total lending capacity across all lenders"
      },
      "rate_range": {
        "type": "object",
        "required": ["lowest", "highest", "average"],
        "properties": {
          "lowest": {"type": "number", "minimum": 0},
          "highest": {"type": "number", "minimum": 0},
          "average": {"type": "number", "minimum": 0}
        }
      },
      "market_depth": {
        "type": "string",
        "enum": ["DEEP", "MODERATE", "SHALLOW"],
        "description": "Assessment of market liquidity depth"
      }
    },
    "additionalProperties": false
  },

  "lender_profiles": {
    "institutional": {
      "typical_capacity_range": [10000, 50000],
      "rate_premium_range": [-0.5, 0.0],
      "approval_time": "2-4 hours",
      "risk_tolerance": ["LOW", "MEDIUM"],
      "min_loan_size": 100
    },
    "private": {
      "typical_capacity_range": [1000, 20000],
      "rate_premium_range": [-0.25, 0.5],
      "approval_time": "1-2 hours",
      "risk_tolerance": ["LOW", "MEDIUM", "HIGH"],
      "min_loan_size": 50
    },
    "community": {
      "typical_capacity_range": [100, 10000],
      "rate_premium_range": [0.0, 1.0],
      "approval_time": "4-8 hours",
      "risk_tolerance": ["MEDIUM", "HIGH"],
      "min_loan_size": 10
    },
    "protocol": {
      "typical_capacity_range": [5000, 30000],
      "rate_premium_range": [-0.5, 0.25],
      "approval_time": "1-2 hours",
      "risk_tolerance": ["LOW", "MEDIUM"],
      "min_loan_size": 25
    }
  },

  "matching_algorithm": {
    "primary_criteria": [
      "available_capacity",
      "interest_rate",
      "risk_tolerance_compatibility",
      "duration_compatibility"
    ],
    "scoring_weights": {
      "rate_competitiveness": 0.4,
      "capacity_adequacy": 0.2,
      "reputation": 0.2,
      "terms_flexibility": 0.2
    },
    "filtering_rules": {
      "minimum_capacity_ratio": 1.0,
      "maximum_rate_deviation": 3.0,
      "reputation_threshold": 60
    }
  },

  "market_simulation": {
    "base_lender_count": {
      "institutional": 2,
      "private": 3,
      "community": 4,
      "protocol": 2
    },
    "availability_factors": {
      "risk_based_filtering": true,
      "capacity_constraints": true,
      "duration_preferences": true,
      "market_volatility_impact": 0.1
    }
  },

  "performance_requirements": {
    "max_execution_time_ms": 2000,
    "target_response_time_ms": 800,
    "memory_usage_mb": 5,
    "concurrent_requests": 10
  },

  "error_handling": {
    "no_lenders_found": "Return empty list with market analysis",
    "insufficient_capacity": "Return partial matches with capacity warnings",
    "rate_too_high": "Return lenders with rate adjustment suggestions",
    "service_timeout": "Return cached results if available"
  },

  "examples": [
    {
      "description": "Standard loan request",
      "input": {
        "loan_amount_algos": 100,
        "target_interest_rate": 8.0,
        "duration_days": 30,
        "borrower_risk_category": "MEDIUM"
      },
      "expected_output": {
        "total_lenders_found": 4,
        "market_depth": "MODERATE",
        "rate_range": {
          "lowest": 7.2,
          "highest": 8.8,
          "average": 7.9
        }
      }
    }
  ]
}