{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Calculate Interest Rate Tool",
  "description": "Risk-based interest rate calculation tool for loan negotiations",
  "type": "object",

  "tool_metadata": {
    "name": "calculate_interest_rate",
    "version": "1.0.0",
    "category": "negotiation",
    "complexity": "medium",
    "execution_time_estimate": "< 100ms",
    "created": "2025-09-14"
  },

  "input_schema": {
    "type": "object",
    "required": ["loan_amount_algos", "duration_days", "borrower_risk_score"],
    "properties": {
      "loan_amount_algos": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 100000,
        "description": "Loan amount in ALGO"
      },
      "duration_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365,
        "description": "Loan duration in days"
      },
      "borrower_risk_score": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Borrower risk score (1-100, higher is better)"
      },
      "market_base_rate": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 30,
        "default": 7.5,
        "description": "Current market base rate percentage"
      },
      "collateral_ratio": {
        "type": "number",
        "minimum": 1.0,
        "maximum": 5.0,
        "default": 1.3,
        "description": "Collateral to loan ratio"
      }
    },
    "additionalProperties": false
  },

  "output_schema": {
    "type": "object",
    "required": ["suggested_interest_rate", "base_rate", "adjustments"],
    "properties": {
      "suggested_interest_rate": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 50,
        "description": "Final calculated interest rate"
      },
      "base_rate": {
        "type": "number",
        "description": "Market base rate used in calculation"
      },
      "adjustments": {
        "type": "object",
        "required": ["risk", "duration", "amount", "collateral"],
        "properties": {
          "risk": {
            "type": "number",
            "description": "Risk-based adjustment to rate"
          },
          "duration": {
            "type": "number",
            "description": "Duration-based adjustment"
          },
          "amount": {
            "type": "number",
            "description": "Amount-based adjustment"
          },
          "collateral": {
            "type": "number",
            "description": "Collateral-based adjustment"
          }
        }
      },
      "factors_considered": {
        "type": "array",
        "items": {"type": "string"},
        "description": "List of factors considered in calculation"
      }
    },
    "additionalProperties": false
  },

  "business_logic": {
    "risk_adjustments": {
      "score_80_plus": -0.5,
      "score_60_to_80": 0.0,
      "score_40_to_60": 1.0,
      "score_below_40": 2.5
    },
    "duration_adjustments": {
      "up_to_30_days": 0.0,
      "31_to_90_days": 0.5,
      "91_to_180_days": 1.0,
      "over_180_days": 1.5
    },
    "amount_adjustments": {
      "over_1000_algo": -0.25,
      "100_to_1000_algo": 0.0,
      "under_100_algo": 0.5
    },
    "collateral_adjustments": {
      "ratio_1_5_plus": -0.5,
      "ratio_1_3_to_1_5": 0.0,
      "ratio_below_1_3": 1.0
    }
  },

  "validation_rules": {
    "rate_bounds": {
      "minimum": 3.0,
      "maximum": 25.0,
      "description": "Final rate must be within acceptable bounds"
    },
    "adjustment_limits": {
      "maximum_positive_adjustment": 5.0,
      "maximum_negative_adjustment": -2.0
    }
  },

  "error_handling": {
    "invalid_input": "Return error with specific field validation messages",
    "calculation_error": "Return base_rate with warning",
    "out_of_bounds": "Clamp to acceptable range and add warning"
  },

  "examples": [
    {
      "description": "Low risk borrower, short term loan",
      "input": {
        "loan_amount_algos": 100,
        "duration_days": 30,
        "borrower_risk_score": 85,
        "market_base_rate": 7.5,
        "collateral_ratio": 1.3
      },
      "expected_output": {
        "suggested_interest_rate": 7.0,
        "adjustments": {
          "risk": -0.5,
          "duration": 0.0,
          "amount": 0.0,
          "collateral": 0.0
        }
      }
    },
    {
      "description": "High risk borrower, long term loan",
      "input": {
        "loan_amount_algos": 50,
        "duration_days": 180,
        "borrower_risk_score": 35,
        "market_base_rate": 7.5,
        "collateral_ratio": 1.8
      },
      "expected_output": {
        "suggested_interest_rate": 9.5,
        "adjustments": {
          "risk": 2.5,
          "duration": 1.0,
          "amount": 0.5,
          "collateral": -0.5
        }
      }
    }
  ],

  "performance_requirements": {
    "max_execution_time_ms": 100,
    "memory_usage_mb": 1,
    "cpu_intensive": false
  }
}