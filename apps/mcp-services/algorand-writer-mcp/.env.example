# =============================================================================
# ALGORAND WRITER MCP SERVICE - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables needed for the Algorand Writer MCP service.
# Copy this file to .env and customize values for your environment.

# -----------------------------------------------------------------------------
# CORE SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=8080

# Service identification
SERVICE_NAME=algorand-writer-mcp
SERVICE_VERSION=0.1.1

# -----------------------------------------------------------------------------
# ALGORAND NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
# Network selection: mainnet, testnet, betanet, localnet
ALGORAND_NETWORK=testnet

# Algod API Configuration
ALGORAND_ALGOD=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_API=https://testnet-api.algonode.cloud/v2
ALGORAND_ALGOD_PORT=
ALGORAND_TOKEN=

# Indexer API Configuration
ALGORAND_INDEXER=https://testnet-idx.algonode.cloud
ALGORAND_INDEXER_API=https://testnet-idx.algonode.cloud/v2
ALGORAND_INDEXER_PORT=

# -----------------------------------------------------------------------------
# MCP PROTOCOL CONFIGURATION
# -----------------------------------------------------------------------------
# Enable read-only mode (set to false for transaction capabilities)
READ_ONLY=false

# Allow mainnet operations (security setting)
ALLOW_MAINNET=false

# Pagination settings
ITEMS_PER_PAGE=10

# -----------------------------------------------------------------------------
# TRANSACTION CONFIGURATION
# -----------------------------------------------------------------------------
# Transaction simulation settings
SIMULATION_ENABLED=true
SIMULATION_TIMEOUT=30000

# Transaction fee configuration
DEFAULT_FEE=1000
MIN_FEE=1000
MAX_FEE=10000

# Transaction signing timeout
SIGNING_TIMEOUT=300000

# -----------------------------------------------------------------------------
# WALLET INTEGRATION
# -----------------------------------------------------------------------------
# Supported wallet types
SUPPORTED_WALLETS=pera,defly,exodus,algosigner

# Wallet connection timeouts
WALLET_CONNECT_TIMEOUT=30000
WALLET_SIGN_TIMEOUT=300000

# -----------------------------------------------------------------------------
# EXTERNAL API INTEGRATIONS
# -----------------------------------------------------------------------------
# NFD (Non-Fungible Domains) API
NFD_API_URL=https://api.nf.domains

# Pera Wallet Integration (Testnet)
PERA_WALLET_API_URL=https://testnet.api.perawallet.app/v1/public
PERA_EXPLORER_URL=https://testnet.explorer.perawallet.app

# -----------------------------------------------------------------------------
# CLOUDFLARE WORKER BINDINGS (Production Deployment)
# -----------------------------------------------------------------------------
# Durable Object Configuration
DURABLE_OBJECT_CLASS=AlgorandActionsMCP

# KV Namespace IDs (if needed)
TRANSACTION_CACHE_ID=
WALLET_SESSION_ID=

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------
# Health check configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Transaction monitoring
TRACK_TRANSACTIONS=true
TRANSACTION_LOG_RETENTION=7d

# Performance monitoring
PERFORMANCE_MONITORING=true
METRICS_COLLECTION=true

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# CORS settings
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Rate limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Transaction security
MAX_TRANSACTION_AMOUNT=1000000000
REQUIRE_CONFIRMATION=true
ENABLE_TRANSACTION_AUDIT=true

# -----------------------------------------------------------------------------
# DEVELOPMENT & TESTING
# -----------------------------------------------------------------------------
# Enable development features (set to false in production)
DEVELOPMENT_MODE=false
DEBUG_TRANSACTIONS=false
MOCK_WALLET_RESPONSES=false

# Testing configuration
TEST_ACCOUNTS_ENABLED=false
TEST_FAUCET_URL=https://bank.testnet.algorand.network