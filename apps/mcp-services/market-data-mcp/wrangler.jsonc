{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-data-mcp",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MarketDataMCP",
        "name": "MARKET_DATA_MCP"
      }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["MarketDataMCP"], "tag": "v1" }
  ],
  "vars": {
    "SERVICE_NAME": "market-data-mcp",
    "SERVICE_VERSION": "1.0.0",
    "PORT": "8789"
  },
  "dev": {
    "port": 8789
  },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    },
    "development": {
      "vars": {
        "ENVIRONMENT": "development"
      }
    }
  }
}