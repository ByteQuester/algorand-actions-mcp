{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# LoanApprovalEngine Test Suite\n",
    "\n",
    "Comprehensive testing of the LoanApprovalEngine with real MCP blockchain data.\n",
    "Tests loan evaluation, ecosystem analysis, and decision-making with real borrower data."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Setup & Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import asyncio\n",
    "import json\n",
    "from decimal import Decimal\n",
    "from datetime import datetime, timedelta"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "sys.path.append('/home/mpo/algorand-showcase/algorand-lending-ecosystem/algorand-lending-business-logic')\n",
    "from algorand_lending_bl.loan_approval import LoanApprovalEngine\n",
    "from algorand_lending_bl.models import LoanRequest, ASAToken, DecisionType\n",
    "from algorand_lending_bl.config import LoanApprovalConfig"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import httpx\n",
    "# MCP Service endpoints\n",
    "READER_URL = \"http://localhost:8002\"\n",
    "WRITER_URL = \"http://localhost:3001\"\n",
    "MARKET_DATA_URL = \"http://localhost:8789\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Test Loan Applications Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test borrower profiles\n",
    "high_value_borrower = \"7ZUECA7HFLZTXENRV24SHLU4AVPUTMTTDUFUBNBD64C5S3XM5THAIOF6Q\"\n",
    "standard_borrower = \"GD64YIY3ZYQKECYR5736IALMJK2SYQHJNVK5UVSMP6JBTCDBBHU5A\"\n",
    "new_borrower = \"CRMMBMPQ7VZISVJCHBCR2T4OUZ5634FXP6BX3BLOBVXB6ZK44IF6CGMLPI\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Standard test assets\n",
    "algo_asset = ASAToken(asset_id=0, name=\"Algorand\", symbol=\"ALGO\")\n",
    "usdc_asset = ASAToken(asset_id=31566704, name=\"USD Coin\", symbol=\"USDC\", decimals=6)\n",
    "test_collateral = [algo_asset, usdc_asset]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Initialize LoanApprovalEngine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create engine with default config\n",
    "approval_engine = LoanApprovalEngine()\n",
    "print(f\"✅ LoanApprovalEngine initialized\")\n",
    "print(f\"📊 Max LTV: {approval_engine.config.max_ltv_ratio:.1%}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Real Account Data Collection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "async def get_account_profile(address: str):\n",
    "    \"\"\"Get comprehensive account profile\"\"\"\n",
    "    try:\n",
    "        async with httpx.AsyncClient() as client:\n",
    "            resp = await client.post(f\"{READER_URL}/tools/get_account_info\", \n",
    "                                   json={\"address\": address})\n",
    "            return resp.json().get(\"account\", {})\n",
    "    except:\n",
    "        return {}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get borrower account data\n",
    "high_value_profile = await get_account_profile(high_value_borrower)\n",
    "standard_profile = await get_account_profile(standard_borrower)\n",
    "new_profile = await get_account_profile(new_borrower)\n",
    "print(f\"👑 High Value: {high_value_profile.get('amount', 0) / 1e6:.2f} ALGO\")\n",
    "print(f\"📊 Standard: {standard_profile.get('amount', 0) / 1e6:.2f} ALGO\")\n",
    "print(f\"🆕 New: {new_profile.get('amount', 0) / 1e6:.2f} ALGO\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Create Test Loan Requests"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Small loan request\n",
    "small_loan = LoanRequest(\n",
    "    borrower=high_value_borrower,\n",
    "    loan_amount_usd=Decimal('500'),\n",
    "    duration_days=30,\n",
    "    collateral_assets=[algo_asset]\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Medium loan request\n",
    "medium_loan = LoanRequest(\n",
    "    borrower=standard_borrower,\n",
    "    loan_amount_usd=Decimal('5000'),\n",
    "    duration_days=90,\n",
    "    collateral_assets=test_collateral\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Large loan request\n",
    "large_loan = LoanRequest(\n",
    "    borrower=new_borrower,\n",
    "    loan_amount_usd=Decimal('50000'),\n",
    "    duration_days=365,\n",
    "    collateral_assets=[algo_asset]\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Small Loan Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate small loan\n",
    "small_decision = await approval_engine.evaluate_loan_application(small_loan)\n",
    "print(f\"💰 Small Loan ($500) Decision:\")\n",
    "print(f\"   Decision: {small_decision.decision_type.value}\")\n",
    "print(f\"   Confidence: {small_decision.confidence.value}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if small_decision.approved_terms:\n",
    "    terms = small_decision.approved_terms\n",
    "    print(f\"✅ Approved Terms:\")\n",
    "    print(f\"   Interest Rate: {terms.interest_rate_annual:.2f}%\")\n",
    "    print(f\"   Amount: ${terms.approved_amount}\")\n",
    "    print(f\"   Duration: {terms.duration_days} days\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Medium Loan Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate medium loan\n",
    "medium_decision = await approval_engine.evaluate_loan_application(medium_loan)\n",
    "print(f\"💼 Medium Loan ($5000) Decision:\")\n",
    "print(f\"   Decision: {medium_decision.decision_type.value}\")\n",
    "print(f\"   Risk Level: {medium_decision.risk_assessment.value}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if medium_decision.alternative_terms:\n",
    "    alt_terms = medium_decision.alternative_terms[0]  # First alternative\n",
    "    print(f\"🔄 Alternative Terms Available:\")\n",
    "    print(f\"   Amount: ${alt_terms.approved_amount}\")\n",
    "    print(f\"   Rate: {alt_terms.interest_rate_annual:.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Large Loan Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate large loan\n",
    "large_decision = await approval_engine.evaluate_loan_application(large_loan)\n",
    "print(f\"🏦 Large Loan ($50000) Decision:\")\n",
    "print(f\"   Decision: {large_decision.decision_type.value}\")\n",
    "print(f\"   Reason: {large_decision.rejection_reason or 'N/A'}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Borrower Ecosystem Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "async def get_borrower_dapps(address: str):\n",
    "    \"\"\"Get DApp interaction history\"\"\"\n",
    "    try:\n",
    "        async with httpx.AsyncClient() as client:\n",
    "            resp = await client.post(f\"{READER_URL}/tools/search_applications\", \n",
    "                                   json={\"limit\": 20})\n",
    "            return resp.json().get(\"applications\", [])\n",
    "    except:\n",
    "        return []"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze ecosystem participation\n",
    "dapps_list = await get_borrower_dapps(high_value_borrower)\n",
    "ecosystem_score = min(len(dapps_list) * 0.1, 1.0)  # Cap at 1.0\n",
    "print(f\"🌐 Ecosystem Analysis:\")\n",
    "print(f\"   DApps Available: {len(dapps_list)}\")\n",
    "print(f\"   Ecosystem Score: {ecosystem_score:.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Risk Factor Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compare decision factors\n",
    "decisions = {\n",
    "    \"Small\": small_decision,\n",
    "    \"Medium\": medium_decision,\n",
    "    \"Large\": large_decision\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"⚖️ Risk Factor Comparison:\")\n",
    "for name, decision in decisions.items():\n",
    "    risk = decision.risk_assessment.value\n",
    "    approved = decision.decision_type == DecisionType.APPROVED\n",
    "    print(f\"   {name}: {risk.upper()} risk, {'✅ Approved' if approved else '❌ Denied'}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Market Condition Impact"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "async def get_market_condition():\n",
    "    \"\"\"Get current market volatility\"\"\"\n",
    "    try:\n",
    "        async with httpx.AsyncClient() as client:\n",
    "            resp = await client.post(f\"{MARKET_DATA_URL}/tools/get_market_data\", \n",
    "                                   json={\"symbol\": \"ALGO\"})\n",
    "            return resp.json().get(\"price_change_24h\", 0)\n",
    "    except:\n",
    "        return 0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Factor in market conditions\n",
    "price_change = await get_market_condition()\n",
    "market_stress = abs(price_change) > 10  # >10% change indicates stress\n",
    "print(f\"📈 Market Condition:\")\n",
    "print(f\"   24h Price Change: {price_change:.2f}%\")\n",
    "print(f\"   Market Stress: {'🔴 High' if market_stress else '🟢 Normal'}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Alternative Loan Proposals"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test alternative proposals for rejected loan\n",
    "if large_decision.alternative_terms:\n",
    "    print(f\"🔄 Alternative Proposals for Large Loan:\")\n",
    "    for i, alt in enumerate(large_decision.alternative_terms[:3]):\n",
    "        print(f\"   Option {i+1}: ${alt.approved_amount} at {alt.interest_rate_annual:.2f}%\")\n",
    "else:\n",
    "    print(f\"❌ No alternatives available for large loan\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Real-Time Decision Factors"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create dynamic loan request based on real data\n",
    "current_algo_balance = high_value_profile.get('amount', 0) / 1e6\n",
    "dynamic_amount = min(current_algo_balance * 0.3, 1000)  # 30% of balance, max $1000\n",
    "dynamic_loan = LoanRequest(\n",
    "    borrower=high_value_borrower,\n",
    "    loan_amount_usd=Decimal(str(dynamic_amount)),\n",
    "    duration_days=60,\n",
    "    collateral_assets=[algo_asset]\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate dynamic loan\n",
    "dynamic_decision = await approval_engine.evaluate_loan_application(dynamic_loan)\n",
    "print(f\"🎯 Dynamic Loan (${dynamic_amount:.0f}) Decision:\")\n",
    "print(f\"   Based on {current_algo_balance:.2f} ALGO balance\")\n",
    "print(f\"   Decision: {dynamic_decision.decision_type.value}\")\n",
    "print(f\"   Confidence: {dynamic_decision.confidence.value}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Performance Benchmarking"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import time\n",
    "# Benchmark approval speed\n",
    "start_time = time.time()\n",
    "for _ in range(3):\n",
    "    await approval_engine.evaluate_loan_application(small_loan)\n",
    "elapsed = time.time() - start_time"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"⚡ Performance Benchmark:\")\n",
    "print(f\"   3 evaluations in {elapsed:.3f}s\")\n",
    "print(f\"   Average: {elapsed/3:.3f}s per evaluation\")\n",
    "print(f\"   Rate: {3/elapsed:.1f} evaluations/second\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Edge Case Testing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test edge cases\n",
    "edge_cases = [\n",
    "    LoanRequest(high_value_borrower, Decimal('0.01'), 1, [algo_asset]),\n",
    "    LoanRequest(standard_borrower, Decimal('1000000'), 1, [algo_asset]),\n",
    "    LoanRequest(new_borrower, Decimal('100'), 3650, [algo_asset])\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"🧪 Edge Case Testing:\")\n",
    "edge_names = [\"Micro Loan\", \"Mega Loan\", \"10-Year Loan\"]\n",
    "for name, case in zip(edge_names, edge_cases):\n",
    "    try:\n",
    "        decision = await approval_engine.evaluate_loan_application(case)\n",
    "        print(f\"   {name}: ✅ {decision.decision_type.value}\")\n",
    "    except Exception as e:\n",
    "        print(f\"   {name}: ❌ {str(e)[:50]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Decision Consistency Test"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test decision consistency\n",
    "consistency_results = []\n",
    "for _ in range(5):\n",
    "    decision = await approval_engine.evaluate_loan_application(small_loan)\n",
    "    consistency_results.append(decision.decision_type)\n",
    "consistent = len(set(consistency_results)) == 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"🔄 Decision Consistency:\")\n",
    "print(f\"   5 evaluations: {'✅ Consistent' if consistent else '❌ Inconsistent'}\")\n",
    "print(f\"   Results: {[r.value for r in consistency_results]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Test Results Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test summary\n",
    "summary = {\n",
    "    \"timestamp\": datetime.now().isoformat(),\n",
    "    \"account_profiles_loaded\": all(p.get('amount', 0) >= 0 for p in [high_value_profile, standard_profile, new_profile]),\n",
    "    \"small_loan_processed\": small_decision is not None,\n",
    "    \"decision_consistency\": consistent,\n",
    "    \"market_data_integrated\": abs(price_change) >= 0\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"📋 LoanApprovalEngine Test Summary:\")\n",
    "for key, value in summary.items():\n",
    "    status = \"✅\" if value else \"❌\"\n",
    "    print(f\"   {key}: {status} {value}\")\n",
    "print(f\"\\n🎯 LoanApprovalEngine Test Suite: {'PASSED' if all(summary.values()) else 'FAILED'}\")"
   ]
  }
 ],
