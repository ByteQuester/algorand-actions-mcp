# Production Dockerfile for A2A Lending API
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY apps/business/a2a-lending-desk/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY apps/business/a2a-lending-desk/ ./
COPY apps/core/ ./core/

# Copy deployment configurations
COPY deployments/production/configs/ ./production_configs/

# Create log directory
RUN mkdir -p /var/log/lending-api

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app /var/log/lending-api
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# Expose port
EXPOSE 8003

# Run the application
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8003", "--workers", "4"]