[Unit]
Description=Algorand Lending Platform - Main Application Stack
Documentation=https://github.com/algorand-showcase/algorand-showcase
After=docker.service
Requires=docker.service
PartOf=algorand-lending-stack.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=algorand
Group=algorand
WorkingDirectory=/opt/algorand-lending

# Environment
Environment=COMPOSE_PROJECT_NAME=algorand-lending
Environment=COMPOSE_FILE=docker-compose.production.yml
EnvironmentFile=/opt/algorand-lending/.env.production

# Pre-start checks
ExecStartPre=/usr/bin/docker-compose -f ${COMPOSE_FILE} config -q
ExecStartPre=/bin/bash -c 'if [ ! -f .env.production ]; then echo "Environment file missing"; exit 1; fi'

# Start services
ExecStart=/usr/bin/docker-compose -f ${COMPOSE_FILE} up -d

# Health check after start
ExecStartPost=/bin/bash -c 'sleep 30; /opt/algorand-lending/scripts/health-check.sh'

# Stop services
ExecStop=/usr/bin/docker-compose -f ${COMPOSE_FILE} down

# Reload services
ExecReload=/usr/bin/docker-compose -f ${COMPOSE_FILE} restart

# Restart policy
Restart=on-failure
RestartSec=30s
TimeoutStartSec=300s
TimeoutStopSec=120s

# Security
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/algorand-lending /var/log/algorand-lending

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=algorand-lending

[Install]
WantedBy=algorand-lending-stack.target
WantedBy=multi-user.target