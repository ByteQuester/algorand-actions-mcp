# Production Environment Configuration Template
# Copy this file to .env.production and configure with real values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://lending_user:CHANGE_THIS_PASSWORD@localhost:5432/algorand_lending
DB_USER=lending_user
DB_PASSWORD=CHANGE_THIS_PASSWORD

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate a secure 256-bit key for JWT tokens
JWT_SECRET=GENERATE_SECURE_256_BIT_KEY_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8003

# =============================================================================
# MCP SERVICES CONFIGURATION
# =============================================================================
REMOTE_MCP_URL=http://localhost:8002
ACTIONS_MCP_URL=http://localhost:3001

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
# Use 'testnet' for testing, 'mainnet' for production
ALGORAND_NETWORK=testnet
ALGOD_URL=https://testnet-api.algonode.cloud
INDEXER_URL=https://testnet-idx.algonode.cloud

# For mainnet (production):
# ALGORAND_NETWORK=mainnet
# ALGOD_URL=https://mainnet-api.algonode.cloud
# INDEXER_URL=https://mainnet-idx.algonode.cloud

# =============================================================================
# TRANSACTION CONFIGURATION
# =============================================================================
ENABLE_REAL_TRANSACTIONS=true
REQUIRE_SIGNATURE=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMITING_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/var/log/lending-api/app.log

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true
ENVIRONMENT=production

# =============================================================================
# SSL/TLS CONFIGURATION (for production)
# =============================================================================
# SSL_CERT_PATH=/etc/ssl/certs/lending-api.pem
# SSL_KEY_PATH=/etc/ssl/private/lending-api.key

# =============================================================================
# EXTERNAL INTEGRATIONS (if needed)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@example.com
# SMTP_PASSWORD=smtp_password

# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================
# Set to 'true' in production to enforce HTTPS
ENFORCE_HTTPS=false

# CORS settings for production
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# Session configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict