# Docker Compose Environment Configuration for Algorand MCP Workers
# Copy this file to .env and customize as needed

# =============================================================================
# Algorand Network Configuration
# =============================================================================

# Network: "testnet" or "mainnet"
ALGORAND_NETWORK=testnet

# Algorand node URLs (leave empty to use public nodes)
ALGORAND_ALGOD=https://testnet-api.algonode.cloud
ALGORAND_INDEXER=https://testnet-idx.algonode.cloud

# Algorand API Token (leave empty for public nodes)
ALGORAND_TOKEN=

# =============================================================================
# MCP Worker Modes
# =============================================================================

# Actions MCP Worker read-only mode
# Set to "true" to disable transaction building/submission
ACTIONS_READ_ONLY=false

# Remote MCP Worker read-only mode  
# Set to "true" to disable wallet/signing features
REMOTE_READ_ONLY=true

# =============================================================================
# OAuth Configuration (Remote MCP Worker)
# =============================================================================
# These are required for full OAuth mode. If missing, Remote MCP will run in read-only mode.

# HashiCorp Vault Worker settings
HCV_WORKER=
HCV_WORKER_URL=

# Vault OIDC configuration
VAULT_ENTITIES=
VAULT_OIDC_ACCESSOR=

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookie encryption key (generate with: openssl rand -hex 32)
COOKIE_ENCRYPTION_KEY=

# =============================================================================
# Development Settings
# =============================================================================

# Set to "development" for verbose logging
NODE_ENV=development

# Port mappings (change if ports conflict)
ACTIONS_PORT=8788
REMOTE_PORT=8789

# =============================================================================
# Monitoring (optional)
# =============================================================================
# Uncomment to enable Prometheus metrics collection
# ENABLE_MONITORING=true

# =============================================================================
# Docker Compose Profiles
# =============================================================================
# Available profiles:
# - default: Just the MCP workers
# - proxy: Include Traefik reverse proxy  
# - monitoring: Include Prometheus + Grafana
#
# Usage: docker-compose --profile monitoring up